# Configuração de endpoints Xano para o EduTrack AI Web (Vite + Vercel)
# Copie para .env.local em desenvolvimento ou cadastre nas Environment Variables da Vercel.

VITE_XANO_AUTH_BASE_URL=https://your-instance.xano.io/api:example_auth
VITE_XANO_SUBJECTS_BASE_URL=https://your-instance.xano.io/api:example_subjects
VITE_XANO_TASKS_BASE_URL=https://your-instance.xano.io/api:example_tasks

# Fallback opcional caso SUBJECTS ou TASKS compartilhem o mesmo API Group
# VITE_XANO_API_BASE_URL=https://your-instance.xano.io/api:example

# Gemini API (opcional — necessário para Flashcards com IA)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
